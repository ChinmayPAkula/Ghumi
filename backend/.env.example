ENVIRONMENT=development

# --- Database / Auth (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- LLM provider (Groq) ---
GROQ_API_KEY=

# --- External data APIs ---
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GOOGLE_PLACES_API_KEY=

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ghumi
LANGSMITH_TRACING=true
SENTRY_DSN=

# --- CORS (comma-separated in real .env parsing if you extend config.py to split it) ---
CORS_ORIGINS=["http://localhost:5173"]
