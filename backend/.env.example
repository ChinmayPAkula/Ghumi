ENVIRONMENT=development

# --- Database / Auth (Supabase) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# --- LLM provider (Groq) ---
GROQ_API_KEY=

# --- External data APIs ---
# Amadeus self-service/test tier was decommissioned 2026-07-17 (Enterprise
# API only now) -- replaced with Duffel (flights) and LiteAPI (hotels).
# Hotelbeds was tried for hotels first but its sandbox quota was too
# restrictive for active development.
DUFFEL_API_KEY=
LITEAPI_KEY=
GOOGLE_PLACES_API_KEY=

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ghumi
LANGSMITH_TRACING=true
SENTRY_DSN=

# --- CORS ---
# Dev default below. In Railway, set this to a JSON array containing the
# real Vercel frontend URL, e.g. ["https://ghumi.vercel.app"] -- requests
# from an origin not in this list are rejected by the browser's CORS check.
CORS_ORIGINS=["http://localhost:5173"]
